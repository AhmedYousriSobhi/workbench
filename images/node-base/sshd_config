# Compute and GPU nodes: key login only, no root, reached from the login node (ssh <node>, ProxyJump, srun).
# Faults (scenario target ssh) drop a file into sshd_config.d; the Include comes first because the first value wins.
Include /etc/ssh/sshd_config.d/*.conf
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile /etc/ssh/authorized_keys
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
AllowTcpForwarding yes
X11Forwarding no
PrintMotd no
