# Key login only, no root, forwarding on (clients reach BMC mocks through this connection).
Port 22
HostKey /etc/ssh/ssh_host_ed25519_key
AuthorizedKeysFile /etc/ssh/authorized_keys
PermitRootLogin no
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
UsePAM no
AllowTcpForwarding yes
X11Forwarding no
PrintMotd no
# SFTP for a client's Files view (issue 716): the stock server from node-base's apt layer, run as the user, no chroot
Subsystem sftp /usr/lib/openssh/sftp-server
