#!/usr/bin/env bash
# Run benchctl with the repo's virtualenv, no activation needed:  ./scripts/benchctl status
set -eu
repo="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
py="$repo/.venv/bin/python"
if [ ! -x "$py" ]; then
  mk="cd $repo && python3 -m venv .venv && .venv/bin/pip install -e '.[dev]'"
  echo "no virtualenv at $repo/.venv." >&2
  if [ -t 0 ] && [ -t 2 ]; then
    printf 'create it now? [y/N] ' >&2; read -r ans
    case "$ans" in y|Y|yes) sh -c "$mk" >&2 || exit 1 ;; *) echo "create it once:  $mk" >&2; exit 1 ;; esac
  else
    echo "create it once:  $mk" >&2; exit 1
  fi
fi
cd "$repo"
exec "$py" -m benchctl.cli "$@"
