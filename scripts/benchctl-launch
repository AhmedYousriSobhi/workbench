#!/usr/bin/env bash
# One command to start, stop and look at workbench.
#   ./scripts/benchctl-launch start [--profile min|std|full]   check the machine, build/start the cluster, start the web page
#   ./scripts/benchctl-launch stop                             stop the web page and the cluster (only the workbench project)
#   ./scripts/benchctl-launch status                           governor, cluster and web page at a glance
#   ./scripts/benchctl-launch open                             print the login link (and open it in a browser when possible)
# No sudo is needed. The memory governor runs as you (pause/stop through Docker) unless the optional system
# service is installed. BENCHCTL_GOVERNOR=auto|user|system|off picks it (default auto: system service if running, else yours).
set -u
repo="$(cd "$(dirname "$0")/.." && pwd)"
cd "$repo" || exit 2
state=compose/generated; pidf=$state/ui.pid; logf=$state/ui.log
port="${BENCHCTL_UI_PORT:-8088}"
mkdir -p "$state"

govpid=$state/governor.pid; govlog=$state/governor.log; govflag=$state/governor.grafana
gov_mode="${BENCHCTL_GOVERNOR:-auto}"
sys_sock=/run/workbench/gov.sock
usock="${XDG_RUNTIME_DIR:-/tmp/workbench-$(id -u)}/workbench/gov.sock"
token_file=$state/secrets/grafana_token

gov_alive() { .venv/bin/python -m benchctl.cli status --socket "$1" >/dev/null 2>&1; }
gov_pid() { [ -f "$govpid" ] && kill -0 "$(cat "$govpid")" 2>/dev/null && cat "$govpid"; }
stop_own_governor() {
  if gov_pid >/dev/null; then kill "$(gov_pid)" 2>/dev/null; sleep 0.5; fi
  rm -f "$govpid" "$govflag" "$usock"
}
start_governor() {  # prints one status line; exports WORKBENCH_GOV_SOCKET for everything started after it
  case "$gov_mode" in
    off) echo "off (BENCHCTL_GOVERNOR=off): memory is not protected"; return 0 ;;
    auto|system) if gov_alive "$sys_sock"; then export WORKBENCH_GOV_SOCKET="$sys_sock"; echo "system service (full protection)"; return 0; fi
      [ "$gov_mode" = system ] && { echo "the system service is not running" >&2; return 1; } ;;
  esac
  if gov_pid >/dev/null && gov_alive "$usock"; then export WORKBENCH_GOV_SOCKET="$usock"; echo "running as you (pause and stop; no sudo)"; return 0; fi
  stop_own_governor
  mkdir -p "${usock%/*}"; chmod 700 "${usock%/*}"
  args=(--user-mode --refresh-interval 5 --socket "$usock" --arrivals-flag "${usock%/*}/arrivals.paused" --workdir "$repo")
  bridge="$(ip -4 -o addr show docker0 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n1)"
  [ -n "$bridge" ] && args+=(--metrics-addr "$bridge:9401")
  grafana=0; tok=""
  [ -s "$token_file" ] && { grafana=1; tok="$(cat "$token_file")"; args+=(--grafana-url http://127.0.0.1:3000); }
  (umask 077; WORKBENCH_GRAFANA_TOKEN="$tok" nohup .venv/bin/python -m governor "${args[@]}" >"$govlog" 2>&1 & echo $! >"$govpid")
  echo "$grafana" >"$govflag"
  for _ in $(seq 1 40); do gov_alive "$usock" && { export WORKBENCH_GOV_SOCKET="$usock"; echo "running as you (pause and stop; no sudo)"; return 0; }; sleep 0.25; done
  echo "the governor did not start; see $govlog" >&2; return 1
}
refresh_governor() {  # the Grafana token only exists after the first `up`: restart our own governor once to use it
  [ -f "$govflag" ] && [ "$(cat "$govflag")" = 0 ] && [ -s "$token_file" ] && gov_pid >/dev/null && start_governor >/dev/null
}

ui_pid() { [ -f "$pidf" ] && kill -0 "$(cat "$pidf")" 2>/dev/null && cat "$pidf"; }
link() { sed -n 's/.*workbench UI: //p' "$logf" 2>/dev/null | tail -1; }
ensure_venv() {
  [ -x .venv/bin/python ] && return 0
  echo "== creating the virtualenv (once)"
  python3 -m venv .venv && .venv/bin/pip install -q -e '.[dev]' || { echo "could not install the tools" >&2; return 1; }
}
start_ui() {
  if ui_pid >/dev/null; then echo "web page already running (pid $(ui_pid))"; return 0; fi
  (umask 077; nohup .venv/bin/python -m webui "$port" >"$logf" 2>&1 & echo $! >"$pidf")
  for _ in $(seq 1 50); do
    [ -n "$(link)" ] && curl -s -o /dev/null "http://127.0.0.1:$port/login" && return 0
    sleep 0.3
  done
  echo "the web page did not start; see $logf" >&2; return 1
}
show_link() {
  echo; echo "Web page: $(link)"
  echo "(the link signs you in once; keep it private, it is only valid on this machine)"
}
open_link() {
  if [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && command -v xdg-open >/dev/null; then xdg-open "$(link)" >/dev/null 2>&1 & fi
}

cmd_start() {
  profile=min
  while [ $# -gt 0 ]; do case "$1" in --profile) profile="$2"; shift ;; *) echo "usage: $0 start [--profile P]" >&2; exit 2 ;; esac; shift; done
  echo "== 1/4 checking the machine"
  out=$(./scripts/check-machine.sh); rc=$?
  printf '%s\n' "$out" | grep -E "WARN|FAIL|fix:|READY"
  [ $rc -eq 0 ] || { echo "Fix the FAIL lines, then run this again."; exit 1; }
  echo "== 2/4 tools"; ensure_venv || exit 1
  echo "== 3/4 governor"
  start_governor || exit 1
  echo "== 4/4 starting the cluster (profile $profile; the first run builds images and takes a few minutes)"
  ./scripts/benchctl up --profile "$profile" || { echo "cluster did not start; ./scripts/benchctl diag collects details" >&2; exit 1; }
  refresh_governor
  start_ui || exit 1
  show_link; open_link
  echo; echo "Stop everything with: ./scripts/benchctl-launch stop"
}
cmd_stop() {
  if ui_pid >/dev/null; then kill "$(ui_pid)" 2>/dev/null; echo "web page stopped"; else echo "web page was not running"; fi
  rm -f "$pidf"
  ./scripts/benchctl down
  stop_own_governor
}
cmd_status() {
  if gov_alive "$sys_sock"; then echo "governor : running (system service)"
  elif gov_alive "$usock"; then echo "governor : running (as you, no sudo)"
  else echo "governor : not running (./scripts/benchctl-launch start starts it)"; fi
  n=$(docker ps --filter name=workbench --format '{{.Names}}' 2>/dev/null | wc -l)
  [ "$n" -gt 0 ] && echo "cluster  : $n containers running" || echo "cluster  : stopped (./scripts/benchctl-launch start)"
  if ui_pid >/dev/null; then echo "web page : running, $(link)"; else echo "web page : stopped"; fi
}
cmd_open() { ui_pid >/dev/null || { echo "web page is not running: ./scripts/benchctl-launch start" >&2; exit 1; }; echo "$(link)"; open_link; }

case "${1:-}" in
  start) shift; cmd_start "$@" ;;
  stop) cmd_stop ;;
  status) cmd_status ;;
  open) cmd_open ;;
  *) sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
