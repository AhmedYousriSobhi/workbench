{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get alerts",
  "description": "Prometheus alerts that are pending or firing. The workbench ships seven default rules (GpuXidCritical, GpuTempHigh, InfinibandPortDown, NodeDrained, NodeDown, ExporterDown, JiraErrors), so empty means none is firing. Exit 1 when Prometheus is not running.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "labels": {
            "type": "object"
          },
          "active_at": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "state",
          "severity",
          "labels",
          "active_at"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "items"
  ]
}
