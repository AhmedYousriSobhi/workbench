{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get nodes",
  "description": "Every node sim.yaml defines; state is absent when no container exists.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "kind",
          "state"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "items"
  ]
}
