{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get traffic",
  "description": "The mocks' own record of client requests. services: true answered, false not reachable, null no per-request record (an older mock image).",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "now": {
      "type": "number"
    },
    "edges": {},
    "services": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "boolean",
          "null"
        ]
      }
    },
    "streams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "who": {
            "type": "string"
          },
          "shape": {
            "type": "string"
          },
          "n": {
            "type": "integer"
          },
          "ok": {
            "type": "integer"
          },
          "client_error": {
            "type": "integer"
          },
          "server_error": {
            "type": "integer"
          },
          "ms": {
            "type": "number"
          }
        },
        "required": [
          "service",
          "who",
          "shape",
          "n",
          "ok",
          "client_error",
          "server_error",
          "ms"
        ]
      }
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "array"
      }
    }
  },
  "required": [
    "contract_version",
    "now",
    "edges",
    "services",
    "streams",
    "recent"
  ]
}
