{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get workbench",
  "description": "The workbench last built with a selection, or null after a plain profile start.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "workbench": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "contract_version",
    "workbench"
  ]
}
