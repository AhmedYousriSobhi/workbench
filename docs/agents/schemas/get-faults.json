{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get faults",
  "description": "What is wrong now: nodes in the page's states down, fault or warn, and faults on a service or credential (kind service or auth: a Jira failure mode, an expired BMC or Kubernetes certificate, an expired Slurm token, a wrong munge key). A target can appear twice. Empty when all is well.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "enum": [
              "down",
              "fault",
              "warn"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "kind",
          "state",
          "label"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "items"
  ]
}
