{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "get faults",
  "description": "Nodes that are not healthy now (the page's node states down, fault and warn). Empty when all is well.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "state": {
            "enum": [
              "down",
              "fault",
              "warn"
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "node",
          "kind",
          "state",
          "label"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "items"
  ]
}
