{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doctor",
  "description": "Host prerequisite checks; exit code 1 when ok is false.",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "pattern": "^WB-DOCTOR-"
          }
        },
        "required": [
          "name",
          "code",
          "status",
          "detail",
          "fix"
        ]
      }
    },
    "tuning": {
      "type": "array",
      "description": "Host tuning commands (SPEC P-3), print-only: doctor never runs them.",
      "items": {
        "type": "object",
        "properties": {
          "setting": {
            "type": "string"
          },
          "current": {
            "type": "string"
          },
          "wanted": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "effect": {
            "type": "string"
          },
          "undo": {
            "type": "string"
          },
          "applied": {
            "type": "boolean"
          },
          "persist": {
            "type": "string"
          },
          "persist_undo": {
            "type": "string"
          }
        },
        "required": [
          "setting",
          "current",
          "wanted",
          "applied",
          "command",
          "effect",
          "undo",
          "persist",
          "persist_undo"
        ]
      }
    }
  },
  "required": [
    "contract_version",
    "ok",
    "checks",
    "tuning"
  ]
}
