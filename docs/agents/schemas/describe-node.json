{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "describe node",
  "description": "Everything known about one node; sections are left out when their source did not answer (see notes).",
  "type": "object",
  "properties": {
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "container": {
      "type": "object"
    },
    "slurm": {
      "type": "object"
    },
    "jobs": {
      "type": "array"
    },
    "bmc": {
      "type": "object"
    },
    "gpus": {
      "type": "object"
    }
  },
  "required": [
    "contract_version",
    "name",
    "kind",
    "notes"
  ]
}
